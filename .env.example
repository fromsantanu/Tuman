# Copy to .env and set values for the local environment. Never commit .env.
APP_ENV=development
APP_URL=http://localhost/Tuman/public
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tuman
DB_CHARSET=utf8mb4
DB_USER=root
DB_PASSWORD=
MAIL_ENABLED=true
MAIL_HOST=your-smtp-server
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password-or-app-password
MAIL_FROM_ADDRESS=your-sender-email
MAIL_FROM_NAME=Tuman
